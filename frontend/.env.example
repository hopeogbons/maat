# Copy to frontend/.env.local for local overrides (gitignored via *.local).
#
# Leave EMPTY in development: the Vite dev server proxies /api to Django.
# On Vercel, set this in Project Settings -> Environment Variables to your
# VPS origin, no trailing slash, i.e. https://maat-api.customersupport.ng
VITE_API_BASE_URL=
