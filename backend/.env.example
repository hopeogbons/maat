# Copy to backend/.env for local development. On the VPS the real values live
# in /etc/maat.env, read by the systemd units and by release-maat (see deploy/README.md).

# Generate with: python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=change-me

# True only on your machine. Never on the VPS.
DEBUG=True

# Comma-separated hostnames Django will answer for. Include any hostname you
# point at 127.0.0.1 in /etc/hosts for local testing.
# VPS example: api.yourdomain.com
ALLOWED_HOSTS=localhost,127.0.0.1,maat.vercel.app

# PostgreSQL connection string. Required.
# Local: create the role/db with backend/scripts/create_local_db.sh
DATABASE_URL=postgres://maat:maat@localhost:5432/maat

# Browser origins allowed to call the API (the React app's URLs).
# Local dev uses the Vite proxy so this is only needed for direct calls.
# VPS example: https://maat.vercel.app,https://maat.yourdomain.com
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Regex form, mainly for Vercel preview deployments, e.g. ^https://maat-.*\.vercel\.app$
CORS_ALLOWED_ORIGIN_REGEXES=

# Same origins as above, required for POST/PUT/DELETE with session auth.
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# Public URL of the React site. The sign-in and signed-out pages link their
# logo and "Back to the site" to it, so it must match where you open the frontend.
# Local default: http://localhost:5173 (or https://maat.vercel.app:5174 with the
# mkcert setup). VPS: https://maat.vercel.app
FRONTEND_URL=http://localhost:5173

# Set to True only if nginx is NOT already redirecting http -> https.
SECURE_SSL_REDIRECT=False

# --- AI provider -------------------------------------------------------------
# The OpenAI key may live here or in the repository-level .env; both are read.
OPENAI_API_KEY=
# Everyday model (reading the visitor, the interview, greetings, contexts).
OPENAI_MODEL=gpt-4.1-mini
# Careful model (judging evidence against a claim, writing the answer).
OPENAI_ANSWER_MODEL=gpt-4.1
OPENAI_RERANK_MODEL=gpt-4.1-mini
# Must produce 1536 dimensions; changing it means re-embedding the corpus.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# The ears and the mouth: a voice note transcribed, a reply read aloud.
OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe
OPENAI_SPEECH_MODEL=gpt-4o-mini-tts
OPENAI_SPEECH_VOICE=marin
# A voice note larger than this is refused before it is transcribed.
VOICE_NOTE_MAX_BYTES=5242880
# Where Telegram reaches this API, e.g. https://api.example.org. Blank: the
# address the dashboard is using when the bot is connected.
PUBLIC_API_URL=
# The bot token from BotFather. Optional: it can be pasted in Settings instead.
TELEGRAM_BOT_TOKEN=
# True: every AI call uses its offline fallback. Useful without a key.
AI_OFFLINE=False
