# systemd unit for the maat Django API on the VPS.
#
# Install:
#   sudo cp /srv/maat/backend/deploy/maat-api.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now maat-api
# Logs:
#   sudo journalctl -u maat-api -f

[Unit]
Description=maat Django API (gunicorn)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=maat
Group=maat
WorkingDirectory=/srv/maat/backend
EnvironmentFile=/srv/maat/backend/.env
ExecStart=/srv/maat/backend/.venv/bin/gunicorn config.wsgi:application --config gunicorn.conf.py
ExecReload=/bin/kill -s HUP $MAINPID
Restart=always
RestartSec=3
KillMode=mixed
TimeoutStopSec=30

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/srv/maat/backend

[Install]
WantedBy=multi-user.target
