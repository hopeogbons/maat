# systemd unit for the feed poller on the VPS.
#
# Install:
#   sudo cp /srv/maat/backend/deploy/maat-poller.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now maat-poller
# Logs:
#   sudo journalctl -u maat-poller -f

[Unit]
Description=maat feed poller
After=network-online.target postgresql.service maat-api.service
Wants=network-online.target postgresql.service

[Service]
Type=simple
User=maat
Group=maat
WorkingDirectory=/srv/maat/backend
EnvironmentFile=/srv/maat/backend/.env
ExecStart=/srv/maat/backend/.venv/bin/python manage.py poll_feeds --loop
Restart=always
RestartSec=10
KillSignal=SIGTERM
TimeoutStopSec=60

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/srv/maat/backend

[Install]
WantedBy=multi-user.target
